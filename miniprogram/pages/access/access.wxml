<view class="page access-page">
  <view class="access-card">
    <view class="access-icon">🔑</view>
    <view class="access-title">需要授权码才能使用</view>
    <view class="access-desc">周末去哪儿是私人收藏工具，请向管理员获取授权码</view>

    <input class="access-input" placeholder="输入授权码" value="{{code}}" bindinput="onInput" bindconfirm="onSubmit" maxlength="20" focus="{{true}}"/>

    <view wx:if="{{error}}" class="access-error">{{error}}</view>

    <button class="access-btn" bindtap="onSubmit" loading="{{checking}}" disabled="{{checking}}">
      进入
    </button>
  </view>
</view>
