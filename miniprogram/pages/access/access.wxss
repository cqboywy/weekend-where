.access-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.access-card {
  width: 100%; max-width: 600rpx;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 64rpx 48rpx 48rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 2rpx 16rpx rgba(44,36,22,0.06);
}

.access-icon {
  font-size: 72rpx; margin-bottom: 28rpx;
}

.access-title {
  font-family: var(--font-heading);
  font-size: var(--text-lg); font-weight: 700;
  color: var(--color-text); margin-bottom: 12rpx;
}

.access-desc {
  font-size: var(--text-sm); color: var(--color-muted);
  text-align: center; line-height: 1.6; margin-bottom: 40rpx;
}

.access-input {
  width: 100%; padding: 24rpx 28rpx;
  font-size: var(--text-base); font-weight: 600;
  background: var(--color-bg); border-radius: var(--radius-md);
  text-align: center; letter-spacing: 4rpx;
}

.access-error {
  font-size: var(--text-sm); color: var(--color-danger);
  margin-top: 16rpx;
}

.access-btn {
  width: 100%; margin-top: 32rpx;
  padding: 24rpx; border-radius: var(--radius-full);
  background: var(--color-primary); color: #fff;
  font-size: var(--text-base); font-weight: 600;
  border: none; text-align: center; line-height: 1.4;
}
.access-btn::after { border: none; }

.access-btn[disabled] {
  background: #D4C5B9; color: rgba(255,255,255,0.7);
}
