<view class="page user-list-page">
  <!-- Summary bar -->
  <view class="summary-bar card">
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-num">{{totalCount}}</view>
        <view class="summary-label">总用户</view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <view class="summary-num">{{activeCount}}</view>
        <view class="summary-label">30天活跃</view>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="center-wrap">
    <text class="muted-text">加载中…</text>
  </view>

  <!-- Empty -->
  <view wx:elif="{{users.length === 0}}" class="center-wrap">
    <text class="muted-text">暂无用户数据</text>
  </view>

  <!-- User list -->
  <view wx:else class="user-list">
    <view class="user-card card"
          wx:for="{{users}}" wx:key="label">
      <view class="user-info">
        <view class="user-name">{{item.label}}</view>
        <view class="user-meta">
          <text>首次 {{item.firstLogin}} · 最近 {{item.lastLogin}}</text>
        </view>
      </view>
      <view class="user-count">
        <view class="count-num">{{item.collectionCount}}</view>
        <view class="count-label">收藏</view>
      </view>
    </view>
  </view>
</view>
