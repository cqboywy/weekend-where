.user-list-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 48rpx;
}

/* Summary */
.summary-bar {
  margin: 28rpx;
  padding: 32rpx 28rpx;
}
.summary-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}
.summary-item {
  text-align: center;
}
.summary-num {
  font-family: var(--font-heading);
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}
.summary-label {
  font-size: var(--text-xs);
  color: var(--color-muted);
  margin-top: 8rpx;
}
.summary-divider {
  width: 1rpx; height: 56rpx;
  background: var(--color-border);
}

/* Center states */
.center-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.muted-text {
  font-size: var(--text-sm);
  color: var(--color-muted);
}

/* User cards */
.user-list {
  padding: 0 28rpx;
}
.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 6rpx;
}
.user-meta {
  font-size: var(--text-xs);
  color: var(--color-muted);
}

/* Collection count badge */
.user-count {
  flex-shrink: 0;
  text-align: center;
  margin-left: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
}
.count-num {
  font-family: var(--font-heading);
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}
.count-label {
  font-size: var(--text-xs);
  color: var(--color-primary);
  font-weight: 500;
  margin-top: 4rpx;
}
